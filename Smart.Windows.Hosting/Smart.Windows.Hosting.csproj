<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFrameworks>net11.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <IsTrimmable>true</IsTrimmable>
    <RootNamespace>Smart</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Usa.Smart.Windows.Hosting</PackageId>
    <Title>Smart.Windows.Hosting</Title>
    <Description>Smart WPF support library</Description>
    <PackageTags>smart wpf hosting</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="Usa.Smart.Core" Version="3.0.0" />
  </ItemGroup>

</Project>
