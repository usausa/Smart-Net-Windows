<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFrameworks>net11.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <IsTrimmable>true</IsTrimmable>
    <RootNamespace>Smart</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Usa.Smart.Windows</PackageId>
    <Title>Smart.Windows</Title>
    <Description>Smart WPF support library</Description>
    <PackageTags>smart wpf mvvm</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.161" />
    <PackageReference Include="Usa.Smart.Converter" Version="3.0.0" />
    <PackageReference Include="Usa.Smart.Core" Version="3.0.0" />
  </ItemGroup>

</Project>
