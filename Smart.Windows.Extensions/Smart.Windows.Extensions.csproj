<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFrameworks>net11.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <IsTrimmable>true</IsTrimmable>
    <RootNamespace>Smart</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Usa.Smart.Windows.Extensions</PackageId>
    <Title>Smart.Windows.Extensions</Title>
    <Description>Smart WPF support library</Description>
    <PackageTags>smart wpf mvvm rx reactive</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smart.Windows\Smart.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.161" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
    <PackageReference Include="Usa.Smart.Core" Version="3.0.0" />
    <PackageReference Include="Usa.Smart.Mvvm" Version="3.0.0" />
    <PackageReference Include="Usa.Smart.Reactive" Version="3.0.0" />
  </ItemGroup>

</Project>
